---
import GuideLayout from '../../layouts/GuideLayout.astro';
import { guides } from '../../data/guide';
export function getStaticPaths() { return ['ja', 'en'].map(lang => ({ params: {lang} })); }
const {lang} = Astro.params;
const ja = lang === 'ja';
---
<GuideLayout lang={lang} title={ja ? 'Horizon 公式ガイド' : 'Horizon Official Guide'} description={ja ? 'DSF Horizonの考え方から、読む・つくる・公開するまで。リードと読者をつなぐ公式ガイド。' : 'Understand DSF, create your pages and share your Read. The official DSF guide.'}>
<section class="hero"><div class="hero-copy"><p class="eyebrow">DSF HORIZON / OFFICIAL GUIDE</p><h1>{ja ? <>その表現を、<br/>そのまま届ける。</> : <>Your expression.<br/>Just as you made it.</>}</h1><p class="intro">{ja ? <>文章も、写真も、余白も。<br/>ページに込めた意図を、読者の手元へ。</> : <>Words, photographs, and the space between.<br/>Bring every page to your readers as you intended.</>}</p><p class="hero-description">{ja ? 'DSF Horizonの考え方から、リードのつくり方、公開まで。ここから、あなたの出版をはじめましょう。' : 'From the idea behind DSF to creating and publishing a Read. Start your publishing journey here.'}</p><div class="actions"><a class="button primary" href={'/' + lang + '/start/'}>{ja ? 'DSF Horizonを知る' : 'Meet DSF Horizon'} <span aria-hidden="true">→</span></a><a class="text-link" href="#guides">{ja ? '目的から探す' : 'Explore the guides'} ↓</a></div></div><div class="hero-art" role="img" aria-label={ja ? '9対16の縦長ページ。文字や図形、余白をひとつの表現として構成したイメージ。' : 'A 9:16 page composed of typography, shapes and white space.'}><div class="art-grid"></div><div class="page-back"></div><div class="sample-page"><div class="page-label">THE SHAPE OF A STORY <span>01</span></div><div class="page-circle"></div><div class="page-line"></div><p class="page-title">LAYOUT<br/>IS<br/><em>CONTENT.</em></p><div class="page-caption">{ja ? '表現には、かたちがある。' : 'Every expression has a shape.'}</div><div class="page-bottom">DIGITAL SPREAD FORMAT <span>9:16</span></div></div><span class="art-note">A PAGE. YOUR INTENTION.</span></div></section>
<section class="principles" aria-label={ja ? 'DSFの特徴' : 'DSF principles'}><p><span>01 /</span> {ja ? 'レイアウトを、そのまま' : 'Preserve the layout'}</p><p><span>02 /</span> {ja ? 'スマートフォンから広がる' : 'Start with the smartphone'}</p><p><span>03 /</span> {ja ? 'オープンなファイル仕様' : 'An open file format'}</p></section>
<section class="guide-section" id="guides"><div class="section-heading"><div><p class="eyebrow">EXPLORE THE GUIDE</p><h2>{ja ? 'いま、したいことから。' : 'What would you like to do?'}</h2></div><p>{ja ? '読む人にも、つくる人にも。' : 'For readers and creators alike.'}</p></div><div class="guide-grid">{guides.map(g => <a class="guide-card" href={'/' + lang + '/' + g.slug + '/'}><span class="card-number">{g.number}</span><h3>{ja ? g.ja : g.en}</h3><p>{ja ? g.descJa : g.descEn}</p><span class="card-arrow" aria-hidden="true">↗</span></a>)}</div></section>
<section class="journey"><div><p class="eyebrow">FROM YOUR DESK TO YOUR READERS</p><h2>{ja ? 'つくる。その先まで。' : 'From creation to connection.'}</h2><p>{ja ? 'DSF Studioでつくったページが、読者に届くまで。' : 'Follow your pages from DSF Studio to your readers.'}</p></div><ol><li><span>{ja ? 'エディター' : 'Editor'}</span><p>{ja ? 'ページをつくる' : 'Compose pages'}</p></li><li><span>{ja ? 'プレス' : 'Press'}</span><p>{ja ? '配信用に仕上げる' : 'Prepare distribution'}</p></li><li><span>{ja ? 'リーズ' : 'Reads'}</span><p>{ja ? '公開状態を管理する' : 'Manage publication'}</p></li><li><span>Reader</span><p>{ja ? '読者に届ける' : 'Reach your readers'}</p></li></ol></section>
</GuideLayout>
